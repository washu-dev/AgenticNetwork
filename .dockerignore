# Build context is the repo root (deployment/dockerfiles/Dockerfile.* COPY
# component dirs from it). Patterns are root-relative, so nested matches need **/.

# VCS and personal laptop-only scaffolding
.git
.github
Local

# Virtualenvs, bytecode and packaging output
**/.venv
**/__pycache__
**/*.py[cod]
**/build
**/dist
**/*.egg-info

# Runtime output and local state (never source)
**/uploaded_handlers
**/logs
**/*.log
.devstack
.devstack-pipeline
.devstack-scenarios
.devstack.env
.deck_build
.enroot
data

# Development/planning docs (not part of any image)
docs/dev

# The skeleton's demo agent and its tests: no image runs them (built agent images
# and the generator's output leave them out too)
agent_skeleton/demo
agent_skeleton/tests

# Secrets must never be baked into an image; the *.example templates are harmless
**/.env
**/.env.*
!**/.env.example
**/*secrets*.env
**/env.local
**/*.local.env
**/*.pem
**/*.key
**/*.p12
**/*credentials*.json
**/*service-account*.json
**/token.json
**/.hf_token
**/google_credentials
# Local databases
**/*.db
**/*.sqlite
**/*.sqlite3

# Test, lint and editor caches
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/htmlcov
**/.DS_Store
**/.claude
.vscode
.idea
