# Google API key for Gemini models
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# Optional: separate Maps API key (falls back to GOOGLE_API_KEY)
# Get one at https://console.cloud.google.com/apis/credentials
# Needs: Geocoding API, Places API, Street View Static API enabled
GOOGLE_MAPS_API_KEY=""

# OpenAI API key (for GPT models: gpt-5.4-mini, gpt-5.4, gpt-4.1-mini, etc.)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
