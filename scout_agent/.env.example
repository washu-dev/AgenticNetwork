# --- Required for all modes ---
OPENAI_API_KEY=
BRAVE_API_KEY=

# --- Phase 2 network settings (only used by `scout serve`) ---
SCOUT_AGENT_NAME=Scout

# Directory daemon (gRPC). Point at your AGNTCY directory peer.
# Local dev: 127.0.0.1:8889 (when running the bundled docker-compose).
# Lab/shared: <dir-host>:8888.
DIRECTORY_ENDPOINT=127.0.0.1:8889

# JSONRPC server: where Scout listens. 0.0.0.0 binds all interfaces so the LAN
# can reach Scout. Pick any free port.
SCOUT_HTTP_HOST=0.0.0.0
SCOUT_HTTP_PORT=9104

# Externally-reachable URL we publish in the AgentCard. Peers use this to call
# Scout, so it MUST be a routable address from their machines. Use your LAN IP
# (run `ip -4 addr` to find it) — 127.0.0.1 means "this same machine" from
# the peer's perspective, so they can't reach you.
SCOUT_PUBLIC_HOST=127.0.0.1

# Optional. By default Scout enumerates every A2A agent in the directory and
# registers them as tools. This list adds extra skill-name searches on top
# (only useful for picking up agents that don't declare integration/a2a).
# Leave empty in normal cases.
SCOUT_PEER_SKILLS=
