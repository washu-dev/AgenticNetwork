#!/usr/bin/env python3
"""Fake ``dirctl`` for the native dev stack (see devstack/fake_dirctl.py).

Point DIRCTL_BIN here (or put this folder first on PATH) and set
FAKE_DIRCTL_STATE to a shared JSON file.
"""
