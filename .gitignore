__pycache__/
*.py[cod]
*$py.class
*.egg-info/
# setuptools output (e.g. agent_skeleton/build/ from a non-editable install)
build/

.pytest_cache/
*.log

# Runtime output: uploaded custom-agent handler trees (never source)
uploaded_handlers/

# Local secrets / runtime configuration
.env
.env.local
.env.*.local
# Real secrets file (CREDENTIALS_ENCRYPTION_KEY, GITHUB_TOKEN, GOOGLE_CLIENT_SECRET).
# Kept out of the shared, world-readable .env — see deployment/secrets.env.example.
# The .example template stays tracked; a real secrets.env must never be committed.
secrets.env
**/secrets.env
agent_directory_service/.runtime/
.venv/
.claude/

# Google OAuth credentials and tokens
deployment/google_credentials/

# Hugging Face token
.hf_token

# ides
.vscode/
.DS_Store
.idea/

# vLLM / HF / CUDA runtime caches (created because HOME=/workspace points at the repo)
.nv/
.cache/
.config/
.triton/
.humming/
hf_cache/

# ra_dep — personal copy; never commit its secrets
ra_dep/.env
ra_dep/**/.env
ra_dep/.hf_token
ra_dep/google_credentials/

*.err
logs/
ra-logs/
.deck_build/


# Development/planning docs — working notes, plans, handoffs, analyses. Only the
# curated reference set at docs/*.md is source-of-truth and git-tracked.
docs/dev/

# Cluster runtime dirs (root-anchored — never source): enroot container cache and
# working data (ADS store / postgres / etc.). Anchored so nested data/ stays trackable.
/.enroot/
/data/