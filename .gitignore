__pycache__/
*.py[cod]
*$py.class
*.egg-info/
# setuptools output (e.g. agent_skeleton/build/ from a non-editable install)
build/

.pytest_cache/
*.log

# Runtime output: uploaded custom-agent handler trees (never source)
uploaded_handlers/

# Local secrets / runtime configuration
.env
.env.local
.env.*.local
# Real secrets file (CREDENTIALS_ENCRYPTION_KEY, GITHUB_TOKEN, GOOGLE_CLIENT_SECRET).
# Kept out of the shared, world-readable .env — see deployment/secrets.env.example.
# The .example template stays tracked; a real secrets.env must never be committed.
secrets.env
**/secrets.env
agent_directory_service/.runtime/
.venv/
.claude/

# Google OAuth credentials and tokens
deployment/google_credentials/

# Hugging Face token
.hf_token

# ides
.vscode/
.DS_Store
.idea/

# vLLM / HF / CUDA runtime caches (created because HOME=/workspace points at the repo)
.nv/
.cache/
.config/
.triton/
.humming/
hf_cache/

# Local deployment copies: never commit their credentials
ra_dep/google_credentials/

*.err
logs/
ra-logs/
.deck_build/


# Development/planning docs — working notes, plans, handoffs, analyses. Only the
# curated reference set at docs/*.md is source-of-truth and git-tracked.
docs/dev/

# Cluster runtime dirs (root-anchored — never source): enroot container cache and
# working data (ADS store / postgres / etc.). Anchored so nested data/ stays trackable.
/.enroot/
/data/

# Personal laptop-only deploy scaffolding. Also in .git/info/exclude locally;
# listed here so a fresh clone is protected too.
/Local/

# Dev stack state (python3 -m devstack): pids, logs, fake directory, env overrides
/.devstack/
/.devstack-pipeline/
/.devstack.env

# Packaging output
dist/
*.whl

# More secrets: env variants, keys, credential and token files. The *.example
# templates stay tracked.
.env.*
!.env.example
*secrets*.env
*.local.env
env.local
*.pem
*.key
*.p12
*credentials*.json
*service-account*.json
token.json

# Model weights and slide decks (large binaries, never source)
*.pt
*.pth
*.safetensors
*.gguf
*.onnx
*.ckpt
*.pptx

# Local databases, exports and deploy state. state/ is anchored because
# planner_agent/main_agent/state/ is source.
*.sqlite
*.sqlite3
*.db
exports/
/state/
**/deploy/state/

# Test, lint and notebook caches
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
node_modules/
.ipynb_checkpoints/
*.swp
Thumbs.db

# Docker Compose: local overrides and database dumps (docs/deployment/COMPOSE.md)
deployment/compose/compose.override.yaml
deployment/compose/*.sql
