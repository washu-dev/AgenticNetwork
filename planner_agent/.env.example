# v3 Main Agent — environment template
# Copy this file to .env.local and fill in your real values.
#   cp v3_main_agent/.env.example v3_main_agent/.env.local
#   $EDITOR v3_main_agent/.env.local
# .env.local is gitignored so your key never lands in version control.

# --- OpenAI ---
OPENAI_API_KEY=sk-REPLACE_ME

# --- LLM behavior ---
MAIN_AGENT_LLM_ENABLED=true
MAIN_AGENT_LLM_PROVIDER=openai
MAIN_AGENT_LLM_MODEL=gpt-4o-mini
MAIN_AGENT_MAX_OUTPUT_TOKENS=1500
MAIN_AGENT_TIMEOUT_SECONDS=60
MAIN_AGENT_MAX_STEPS=10

# --- Policy (permissive lets write skills run; strict requires confirmation) ---
MAIN_AGENT_POLICY_MODE=permissive
MAIN_AGENT_HISTORY_LIMIT=20

# --- ADS discovery ---
# Use the in-process fake ADS (no dirctl daemon needed):
AGENT_NETWORK_FAKE_ADS=true
# To use a real local ADS daemon instead, comment the line above and set:
# AGENT_NETWORK_FAKE_ADS=false
# ADS_BACKEND=cli
# ADS_SERVER_ADDR=localhost:8888

# --- Auth & credential storage ---
# Generate with: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_BASE64

# Shared Postgres (same instance as registration service)
REGISTRATION_DB_DSN=postgresql://postgres@localhost:5432/registration

# Google OAuth 2.0 web client (from Google Cloud Console)
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://agenticweb.engr.wustl.edu/auth/google/callback

# --- Bug reporting & feedback (planner POST /issues) ---
# Token with Issues:write on GITHUB_ISSUES_REPO, used to file user-submitted bug
# reports and agent-creation feedback as GitHub issues. If unset, the reporting
# forms fail loud (HTTP 502) rather than silently dropping a report. Leave unset
# for local UI testing; the forms still render and show the failure message.
# GITHUB_ISSUES_TOKEN=REPLACE_ME
# GITHUB_ISSUES_REPO=washu-dev/AgenticNetwork

# --- Conversation history ---
# Persisted in Postgres (table conversation_messages) via REGISTRATION_DB_DSN below —
# no separate config. Without a DB, chat history lives only in-process (dev/test).

# --- Admin access (P4f) ---
# Comma-separated allowlist of admin emails (matched against the SSO identity).
# Admin routes fail closed: an empty/unset list means there are NO admins.
# The old shared MAIN_AGENT_ADMIN_TOKEN is retired.
# ADMIN_EMAILS=you@wustl.edu,teammate@wustl.edu

# --- Server ---
MAIN_AGENT_HOST=0.0.0.0
MAIN_AGENT_PORT=8090
MAIN_AGENT_LOG_LEVEL=INFO
