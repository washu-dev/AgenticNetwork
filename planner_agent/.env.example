# v3 Main Agent — environment template
# Copy this file to .env.local and fill in your real values.
#   cp v3_main_agent/.env.example v3_main_agent/.env.local
#   $EDITOR v3_main_agent/.env.local
# .env.local is gitignored so your key never lands in version control.

# --- OpenAI ---
OPENAI_API_KEY=sk-REPLACE_ME

# --- LLM behavior ---
MAIN_AGENT_LLM_ENABLED=true
MAIN_AGENT_LLM_PROVIDER=openai
MAIN_AGENT_LLM_MODEL=gpt-4o-mini
# Reasoning models (gpt-5.x, o-series): set 'medium' or 'high' to surface
# reasoning summaries in the GUI. 'low' and 'minimal' produce empty summaries.
MAIN_AGENT_REASONING_EFFORT=medium
# MAIN_AGENT_VERBOSITY=low
MAIN_AGENT_MAX_OUTPUT_TOKENS=1500
MAIN_AGENT_TIMEOUT_SECONDS=60
MAIN_AGENT_MAX_STEPS=10

# --- Policy (permissive lets write skills run; strict requires confirmation) ---
MAIN_AGENT_POLICY_MODE=permissive
MAIN_AGENT_HISTORY_LIMIT=20

# --- ADS discovery ---
# Use the in-process fake ADS (no dirctl daemon needed):
AGENT_NETWORK_FAKE_ADS=true
# To use a real local ADS daemon instead, comment the line above and set:
# AGENT_NETWORK_FAKE_ADS=false
# ADS_BACKEND=cli
# ADS_SERVER_ADDR=localhost:8888

# --- Server ---
MAIN_AGENT_HOST=0.0.0.0
MAIN_AGENT_PORT=8090
MAIN_AGENT_LOG_LEVEL=INFO
