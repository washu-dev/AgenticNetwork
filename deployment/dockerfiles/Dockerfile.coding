# Coding agent (mini-swe-agent) — port 9106
# Build from repo root:
#   docker build --platform linux/amd64 -f deployment/dockerfiles/Dockerfile.coding \
#       -t amaankhan25/agenticnetwork-coding:latest .
FROM ghcr.io/agntcy/dir-ctl:v1.2.0 AS dirctl-src

FROM continuumio/miniconda3:24.9.2-0

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=dirctl-src /dirctl /usr/local/bin/dirctl
RUN chmod +x /usr/local/bin/dirctl

WORKDIR /app

RUN conda install -n base -c conda-forge mamba -y --quiet

COPY coding_agent/environment.yml coding_agent/environment.yml
RUN mamba env create -f coding_agent/environment.yml --quiet

COPY coding_agent/ coding_agent/
COPY deployment/entrypoints/entrypoint-coding.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PATH=/opt/conda/envs/coding-agent-a2a/bin:$PATH
ENV PYTHONPATH=/app

EXPOSE 9106

ENTRYPOINT ["/entrypoint.sh"]
