# Intelligence agent (analyst / situational briefs) — port 9105
# Build from repo root:
#   docker build --platform linux/amd64 -f deployment/dockerfiles/Dockerfile.intelligence \
#       -t amaankhan25/agenticnetwork-intelligence:latest .
FROM ghcr.io/agntcy/dir-ctl:v1.2.0 AS dirctl-src

FROM continuumio/miniconda3:24.9.2-0

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=dirctl-src /dirctl /usr/local/bin/dirctl
RUN chmod +x /usr/local/bin/dirctl

WORKDIR /app

RUN conda install -n base -c conda-forge mamba -y --quiet

COPY intelligence_agent/environment.yml intelligence_agent/environment.yml
RUN mamba env create -f intelligence_agent/environment.yml --quiet

COPY intelligence_agent/ intelligence_agent/
COPY deployment/entrypoints/entrypoint-intelligence.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PATH=/opt/conda/envs/intelligence-agent-a2a/bin:$PATH
ENV PYTHONPATH=/app

EXPOSE 9105

ENTRYPOINT ["/entrypoint.sh"]
