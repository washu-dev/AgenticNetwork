# ─────────────────────────────────────────────────────────────────────────────
# secrets.env — REAL secrets, kept OUT of the shared, world-readable deployment/.env.
#
# submit.sbatch sources this file AFTER .env (so these override), from:
#   • prod : /engrfs/project/di2/secrets/agenticnetwork.env   (shared among authorized
#            operators via group perms — stable CREDENTIALS_ENCRYPTION_KEY)
#   • test : $HOME/.config/agenticnetwork/secrets.env          (per-user, private)
# Override the path with SECRETS_FILE=/path/to/secrets.env.
#
# SETUP (do NOT commit the real file — it is gitignored):
#   prod (shared, group-readable, not world-readable):
#     sudo install -d -m 0750 -g <your-group> /engrfs/project/di2/secrets
#     cp deployment/secrets.env.example /engrfs/project/di2/secrets/agenticnetwork.env
#     chmod 0640 /engrfs/project/di2/secrets/agenticnetwork.env   # fill in real values
#   test (per-user, private):
#     mkdir -p ~/.config/agenticnetwork && chmod 0700 ~/.config/agenticnetwork
#     cp deployment/secrets.env.example ~/.config/agenticnetwork/secrets.env
#     chmod 0600 ~/.config/agenticnetwork/secrets.env
#
# See docs/MULTI_CONTRIBUTOR.md (Phase 1).
# ─────────────────────────────────────────────────────────────────────────────

# AES-256-GCM key encrypting ALL stored per-user credentials in Postgres. MUST stay
# stable across prod runs, or existing stored credentials become undecryptable.
# Generate: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_BASE64

# GitHub PAT with write access to GITHUB_REPO (agent-directory), for the cluster
# custom-agent build pipeline. Without it, approving a custom agent falls back to
# direct spawning. (GITHUB_REPO itself is non-secret and stays in .env.)
GITHUB_TOKEN=REPLACE_ME

# Google OAuth 2.0 web-client SECRET (from the agentic-web app in Google Cloud
# Console). The paired GOOGLE_CLIENT_ID / GOOGLE_REDIRECT_URI are non-secret and
# stay in .env.
GOOGLE_CLIENT_SECRET=REPLACE_ME
