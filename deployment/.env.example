# Master environment file — copy to .env and fill in real values
# cp deployment/.env.example deployment/.env
#
# This is the template for WashU's ENGR cluster deployment (docs/deployment/engr/),
# so its host names and paths are WashU's. Other deployments replace them; for a
# laptop or single machine see docs/DEVSTACK.md or docs/deployment/COMPOSE.md.
#
# NON-SECRET config only. Real secrets (CREDENTIALS_ENCRYPTION_KEY, GITHUB_TOKEN,
# GOOGLE_CLIENT_SECRET) do NOT belong here — this file is shared and world-readable
# on /engrfs. They live in a restricted secrets file; see deployment/secrets.env.example.

# ── LLM — vLLM on RIS ────────────────────────────────────────────────────────
# Replace YOURNODE with the compute node your vLLM job is running on e.g. c2-gpu-013
OPENAI_BASE_URL=http://YOURNODE:8100/v1    # OpenAI SDK (planner, email, disaster, geospatial)
OPENAI_API_BASE=http://YOURNODE:8100/v1   # litellm (intelligence, coding)
OPENAI_API_KEY=dummy

# Must exactly match --served-model-name in your vLLM sbatch
PLANNER_LLM_MODEL=openai/gpt-oss-120b
INTEL_AGENT_MODEL=openai/gpt-oss-120b
CODING_AGENT_MODEL=openai/gpt-oss-120b
EMAIL_AGENT_MODEL=openai/gpt-oss-120b
DISASTER_AGENT_MODEL=openai/gpt-oss-120b

# ── Agent Directory Service ───────────────────────────────────────────────────
ADS_SERVER_ADDR=localhost:8888
ADS_SERVER_ADDRESS=localhost:8888
ADS_BACKEND=cli
AGENT_NETWORK_FAKE_ADS=false
ADS_URL=localhost:8888
DIRECTORY_ENDPOINT=127.0.0.1:8888
DIRCTL_BIN=/usr/local/bin/dirctl
# ADS routing can take up to ~10s to reflect a freshly pushed record
# (publication.scheduler_interval 5s + reconciler.indexer.interval 5s in
# ads_daemon.yaml). Agents verify routing before going live; the default 8s poll
# is shorter than that worst case → "stored but not routed" startup crashes.
# Give the verification window ample margin (applies to every agent + the
# registration service's custom-agent publishes, which use agentnet/directory/publisher.py).
ADS_ROUTING_PUBLISH_TIMEOUT_SECONDS=30
ADS_ROUTING_PUBLISH_POLL_SECONDS=0.5

# ── Auth & credential storage ─────────────────────────────────────────────────
# CREDENTIALS_ENCRYPTION_KEY is a SECRET — it lives in the secrets file, NOT here.
# See deployment/secrets.env.example.

# Shared Postgres — its own container (entrypoint-postgres.sh creates this DB); the
# chat app and registration service connect over localhost TCP. asyncpg accepts
# postgresql:// and postgres:// URLs only. The old name REGISTRATION_DB_DSN still
# works (logged as deprecated); DATABASE_URL wins when both are set. submit.sbatch
# ignores a database address in the submitting shell (either name, or PGHOST, PGPORT
# and the other PG* variables) and exports this value under both names. Agents the
# registration service starts do not get this variable.
DATABASE_URL=postgresql://postgres@localhost:5432/registration

# ── Image registry ────────────────────────────────────────────────────────────
# Namespace all images (built, pulled by submit.sbatch, and custom-agent images the
# registration service builds/pulls) live under. Group-owned rather than tied to a
# personal account. Defaults to di2washu if unset. See docs/MULTI_CONTRIBUTOR.md.
IMAGE_REGISTRY=di2washu

# ── Custom agent handlers (registration service) ──────────────────────────────
# Where uploaded handler files live (mounted via /workspace on the cluster).
HANDLER_FILES_DIR=/workspace/registration_service/uploaded_handlers
# SPAWN_BACKEND=cluster activates ClusterBackend + the GitHub→DockerHub build
# pipeline for approved custom agents. Leave unset for local subprocess spawning.
SPAWN_BACKEND=cluster
# GITHUB_TOKEN is a SECRET (PAT with write access to GITHUB_REPO) — it lives in the
# secrets file, NOT here. See deployment/secrets.env.example. Required for the cluster
# build pipeline; without it, approving an uploaded-code agent fails (nothing is started).
GITHUB_REPO=washu-dev/agent-directory
# Target repo (owner/name) for user-submitted bug reports / agent-creation feedback
# (the chat app's POST /issues). Must be a PRIVATE repo: issues carry the reporter's email,
# recent prompts and trace. No default — unset, the forms fail loud (HTTP 502).
# Non-secret. The paired GITHUB_ISSUES_TOKEN is a SECRET and lives in the secrets file.
GITHUB_ISSUES_REPO=
# Admin access (P4f): comma-separated allowlist of admin emails, matched against the
# SSO identity. BOTH the chat app and registration service read this — set it once here
# (deployment/.env is shared). Fail-closed: empty/unset => no admins.
ADMIN_EMAILS=REPLACE_ME@example.com
# (agent_skeleton is vendored into each generated image's build context, so no
# token or external repo access is needed to build custom agent images.)

# Google OAuth 2.0 web client (from Google Cloud Console → agentic-web app).
# Authorized redirect URI must be: https://agenticweb.engr.wustl.edu/auth/google/callback
# GOOGLE_CLIENT_ID / GOOGLE_REDIRECT_URI are non-secret and stay here; the paired
# GOOGLE_CLIENT_SECRET is a SECRET and lives in the secrets file (see secrets.env.example).
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_REDIRECT_URI=https://agenticweb.engr.wustl.edu/auth/google/callback

# ── Chat app ───────────────────────────────────────────────────────────────────
# CHAT_APP_* tune the chat app (the web server); PLANNER_* tune the planner loop
# inside it. The old MAIN_AGENT_* names (and PLANNER_ALLOW_ANON) still work; the
# server logs a warning for each one it finds. submit.sbatch sets the port itself.
CHAT_APP_HOST=0.0.0.0
CHAT_APP_PORT=8090
PLANNER_LLM_ENABLED=true
PLANNER_LLM_PROVIDER=openai
PLANNER_LLM_MAX_OUTPUT_TOKENS=1500
PLANNER_LLM_TIMEOUT_SECONDS=120
A2A_HTTP_TIMEOUT_SECONDS=180
PLANNER_MAX_STEPS=15
PLANNER_POLICY_MODE=permissive
PLANNER_HISTORY_LIMIT=20
CHAT_APP_LOG_LEVEL=INFO
# Legacy agents (agent_id, as listed by GET /agents) that still get the user's WHOLE
# credential bundle. Every other agent gets only the types it declares and the user
# grants. The email agent reads google_oauth without declaring it; drop an entry once
# that agent declares its credentials.
PLANNER_UNSCOPED_CREDENTIAL_AGENTS=email-agent,geospatial-agent

# ── Scout ─────────────────────────────────────────────────────────────────────
# BRAVE_API_KEY is now stored per-user in the credential DB; remove from env.
SCOUT_AGENT_NAME=Scout
SCOUT_HTTP_HOST=0.0.0.0
SCOUT_HTTP_PORT=9104
SCOUT_PUBLIC_HOST=127.0.0.1

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_AGENT_A2A_HOST=0.0.0.0
EMAIL_AGENT_A2A_PORT=9103
EMAIL_AGENT_A2A_URL=http://127.0.0.1:9103/
EMAIL_AGENT_TIMEZONE=US/Central
EMAIL_AGENT_STATUS_LOGS=1
EMAIL_AGENT_LOG_MAX_CHARS=900
GOOGLE_CALENDAR_ID=
# GOOGLE_CALENDAR_TOKEN, GOOGLE_CALENDAR_CREDENTIALS, and EMAIL_AGENT_EMAIL are now
# stored per-user in the credential DB via the Google OAuth flow; remove from env.

# ── Coding ────────────────────────────────────────────────────────────────────
# 5-digit ports (19105-19108) avoid collisions on shared cluster nodes; these must
# match submit.sbatch's port exports (the authoritative source, which overrides these).
CODING_AGENT_A2A_HOST=0.0.0.0
CODING_AGENT_A2A_PORT=19106
CODING_AGENT_LOG_LEVEL=info
CODING_AGENT_DIRECTORY_URL=localhost:8888
MSWEA_SILENT_STARTUP=1
MSWEA_COST_TRACKING=ignore_errors

# ── Intelligence ──────────────────────────────────────────────────────────────
INTEL_AGENT_A2A_HOST=0.0.0.0
INTEL_AGENT_A2A_PORT=19107
INTEL_AGENT_LOG_LEVEL=info
INTEL_AGENT_DIRECTORY_URL=localhost:8888

# ── Disaster Response ─────────────────────────────────────────────────────────
DISASTER_AGENT_A2A_HOST=0.0.0.0
DISASTER_AGENT_A2A_PORT=19108
DISASTER_AGENT_A2A_URL=http://127.0.0.1:19108/

# ── GeoSpatial ────────────────────────────────────────────────────────────────
GEOSPATIAL_AGENT_A2A_HOST=0.0.0.0
GEOSPATIAL_AGENT_A2A_PORT=19105
# GOOGLE_API_KEY and GOOGLE_MAPS_API_KEY are now stored per-user in the credential
# DB and injected by the planner at request time; remove from env.
