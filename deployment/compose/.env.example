# Docker Compose settings: cp .env.example .env (next to compose.yaml).
# Every line is optional; the commented values are the defaults. Guide:
# docs/deployment/COMPOSE.md.

# ── Front door ────────────────────────────────────────────────────────────────
# Host address and port of the one published port (the chat UI is at /app).
# Keep 127.0.0.1 unless an authenticating proxy is the front door.
# FRONT_DOOR_BIND=127.0.0.1
# FRONT_DOOR_PORT=18080
# The user the dev identity proxy signs every request in as.
# DEV_USER_EMAIL=dev@example.test
# Admins (comma-separated), matched against the signed-in email.
# ADMIN_EMAILS=dev@example.test

# ── LLM ───────────────────────────────────────────────────────────────────────
# Default: the offline mock LLM inside the stack. For a real model, set all of
# OPENAI_BASE_URL, OPENAI_API_KEY and PLANNER_LLM_MODEL (any OpenAI-compatible
# Chat Completions API), before the first start or after `docker compose down -v`.
# (PLANNER_LLM_MODEL's old name, MAIN_AGENT_LLM_MODEL, still works.)
# OPENAI_BASE_URL=http://127.0.0.1:8099/v1
# OPENAI_API_KEY=mock-key
# PLANNER_LLM_MODEL=mock-planner
# The model the seed agents are registered with (default: PLANNER_LLM_MODEL).
# DEVSTACK_SPECIALIST_MODEL=

# Example, hosted OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# PLANNER_LLM_MODEL=gpt-4o-mini

# ── Secrets ───────────────────────────────────────────────────────────────────
# AES-256-GCM key for the per-user credentials the planner stores in Postgres.
# Needed before any user saves a credential; keep it stable and secret.
# Generate: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# CREDENTIALS_ENCRYPTION_KEY=
